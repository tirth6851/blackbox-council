APP_ENV=development
MODEL_MODE=mock
DATABASE_URL=sqlite:///./runtime/blackbox.db
CORS_ORIGINS=["http://localhost:3000"]

# --- Phase 2 (live Nemotron council). Leave unset for mock-only use. ---
# NEBIUS_API_KEY=
# NEBIUS_MODEL=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
# MODEL_TIMEOUT_SECONDS=45
# LIVE_RUN_MAX_REQUESTS=18
# LIVE_RUN_CONCURRENCY=1
# LIVE_RUN_DEADLINE_SECONDS=600
# DAILY_MODEL_CALL_CAP=200
# OPERATOR_CREDENTIAL=
# When set, POST /evaluations (mode=live), /approvals, /execute, and
# /rollback all require an "X-Operator-Credential" header matching this
# value (401 otherwise). Unset (the default) leaves them open, matching
# the local/demo scope; set this before exposing the API beyond localhost.

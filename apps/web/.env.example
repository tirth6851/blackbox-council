# Where this app's own /api/v1/evaluations/* proxy route forwards to.
# Despite the NEXT_PUBLIC_ prefix (kept for backward compatibility — this
# value is only a URL, not a secret), it is read server-side by
# app/api/v1/evaluations/[[...path]]/route.ts, not by any browser code.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Set this to the SAME value as the backend's OPERATOR_CREDENTIAL to
# protect approval/execute/rollback and live-run creation in a public
# deployment. Deliberately NOT prefixed NEXT_PUBLIC_: that would inline it
# into the client bundle and hand the shared secret to every visitor's
# browser. Leave unset for the local/demo default (matches an unset
# backend OPERATOR_CREDENTIAL).
# OPERATOR_CREDENTIAL=
